[Unit]
Description=Floatdesk X11 host
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/floatdesk serve --existing
Restart=on-failure
RestartSec=2
LimitFSIZE=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
